#!/bin/bash
#SBATCH --job-name=memory-r1-mm-rl
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=06:00:00
#SBATCH --output=logs/mm_rl.log

# Phase 2: Memory Manager GRPO Training
# Trains MM with indirect EM reward via frozen AA
# Needs more memory (frozen AA + training MM) and more time (expensive reward)
# Expected: ~500 steps, ~16-20 hours on A100

set -euo pipefail

# Environment
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

cd /projects/prjs1800/tmp/agents-memory

# Ensure logs directory exists
mkdir -p logs

# Install/sync dependencies
echo "=== Syncing dependencies ==="
uv sync --extra training

# Print environment info
echo "=== Environment ==="
uv run python -c "import torch; print(f'PyTorch {torch.__version__}, CUDA {torch.cuda.is_available()}, GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"N/A\"}')"

# Verify Phase 1 output exists
FROZEN_AA_PATH="models/memory-r1-rl/adapter_answer_agent_rl/best"
if [ ! -d "$FROZEN_AA_PATH" ]; then
    FROZEN_AA_PATH="models/memory-r1-rl/adapter_answer_agent_rl/final"
fi

if [ ! -d "$FROZEN_AA_PATH" ]; then
    echo "ERROR: No AA RL adapter found. Run Phase 1 (train_aa_rl.job) first."
    exit 1
fi
echo "Using frozen AA from: $FROZEN_AA_PATH"

# Run Phase 2: Memory Manager GRPO
echo "=== Starting MM GRPO Training ==="
uv run python scripts/train_memory_r1_rl_tracked.py \
    --phase mm \
    --base-model Qwen/Qwen2.5-7B-Instruct \
    --frozen-aa-path "$FROZEN_AA_PATH" \
    --max-steps 100 \
    --eval-every 20 \
    --checkpoint-every 50

echo "=== MM GRPO Training Complete ==="
echo "Metrics: models/memory-r1-rl/adapter_memory_manager_rl/metrics.jsonl"
