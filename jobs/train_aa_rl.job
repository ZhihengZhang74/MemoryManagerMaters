#!/bin/bash
#SBATCH --job-name=memory-r1-aa-rl
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=logs/aa_rl.log

# Phase 1: Answer Agent GRPO Training
# Trains AA with direct EM reward (Paper Eq. 4)
# Expected: ~500 steps, ~8-10 hours on A100

set -euo pipefail

# Environment
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

cd /projects/prjs1800/tmp/agents-memory

# Ensure logs directory exists
mkdir -p logs

# Install/sync dependencies
echo "=== Syncing dependencies ==="
uv sync --extra training

# Print environment info
echo "=== Environment ==="
uv run python -c "import torch; print(f'PyTorch {torch.__version__}, CUDA {torch.cuda.is_available()}, GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"N/A\"}')"
uv run python -c "import trl; print(f'TRL {trl.__version__}')"
uv run python -c "import peft; print(f'PEFT {peft.__version__}')"

# Run Phase 1: Answer Agent GRPO
echo "=== Starting AA GRPO Training ==="
uv run python scripts/train_memory_r1_rl_tracked.py \
    --phase aa \
    --base-model Qwen/Qwen2.5-7B-Instruct \
    --max-steps 100 \
    --eval-every 20 \
    --checkpoint-every 50

echo "=== AA GRPO Training Complete ==="
echo "Metrics: models/memory-r1-rl/adapter_answer_agent_rl/metrics.jsonl"
