#!/bin/bash
#SBATCH --job-name=eval-mm-rl
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=01:00:00
#SBATCH --output=logs/eval_mm.log

set -euo pipefail
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TOKENIZERS_PARALLELISM=false
cd /projects/prjs1800/tmp/agents-memory
uv run python scripts/eval_mm_standalone.py
